## Production builds require one explicit profile: public_site or enterprise.
## public_site is a stateless marketing/legal surface; enterprise additionally
## requires all identity, storage and database evidence below.
COMPLIANCEHUB_RELEASE_PROFILE=
COMPLIANCEHUB_RELEASE_CHANNEL=
COMPLIANCEHUB_PUBLIC_SITE_READY=false
COMPLIANCEHUB_PUBLIC_LEAD_CAPTURE_ENABLED=false

COMPLIANCEHUB_API_BASE_URL=http://localhost:8000
COMPLIANCEHUB_API_ALLOWED_HOSTS=localhost
# Legacy global API keys are forbidden in the enterprise production profile.
COMPLIANCEHUB_API_KEY=
COMPLIANCEHUB_TENANT_ID=tenant-overview-001
COMPLIANCEHUB_SESSION_TTL_MINUTES=480
COMPLIANCEHUB_APP_ORIGIN=http://localhost:3000
COMPLIANCEHUB_PUBLIC_DEMO_ENABLED=false
NEXT_PUBLIC_FEATURE_DEMO_AZURE_INFERENCE=false
# Separate admin-only demo seed credential. Production accepts only a mounted file.
COMPLIANCEHUB_DEMO_SEED_API_KEY=
COMPLIANCEHUB_DEMO_SEED_API_KEY_FILE=
# Direct secret values are development-only. Production mounts these files from OpenBao.
COMPLIANCEHUB_BFF_SHARED_SECRET=
COMPLIANCEHUB_BFF_SHARED_SECRET_FILE=
COMPLIANCEHUB_ENTRA_ENABLED=false
# Local password login/self-registration are development-only in the enterprise profile.
COMPLIANCEHUB_PASSWORD_LOGIN_ENABLED=false
COMPLIANCEHUB_SELF_REGISTRATION_ENABLED=false
COMPLIANCEHUB_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
COMPLIANCEHUB_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
COMPLIANCEHUB_ENTRA_CLIENT_SECRET=
COMPLIANCEHUB_ENTRA_CLIENT_SECRET_FILE=
COMPLIANCEHUB_ENTRA_PROVIDER_ID=00000000-0000-0000-0000-000000000000
COMPLIANCEHUB_AUTH_TRANSACTION_SECRET=
COMPLIANCEHUB_AUTH_TRANSACTION_SECRET_FILE=
COMPLIANCEHUB_ENTRA_CONDITIONAL_ACCESS_READY=false
COMPLIANCEHUB_ENTRA_PROVISIONING_READY=false
# Development-only escape hatch for browser/CSP testing. Enterprise production rejects it
# and routes all authenticated browser traffic through the same-origin BFF.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_TENANT_ID=tenant-overview-001
# Never define NEXT_PUBLIC_API_KEY. NEXT_PUBLIC_* values are shipped to browsers.

COMPLIANCEHUB_LEGAL_ENTITY_NAME=
COMPLIANCEHUB_LEGAL_REPRESENTATIVE=
COMPLIANCEHUB_LEGAL_STREET=
COMPLIANCEHUB_LEGAL_POSTAL_CODE=
COMPLIANCEHUB_LEGAL_CITY=
COMPLIANCEHUB_LEGAL_COUNTRY=Deutschland
COMPLIANCEHUB_LEGAL_EMAIL=
COMPLIANCEHUB_LEGAL_PHONE=
COMPLIANCEHUB_LEGAL_REGISTER_COURT=
COMPLIANCEHUB_LEGAL_REGISTER_NUMBER=
COMPLIANCEHUB_LEGAL_VAT_ID=
COMPLIANCEHUB_PRIVACY_EMAIL=
COMPLIANCEHUB_PRIVACY_DPO_CONTACT=
COMPLIANCEHUB_PRIVACY_NOTICE_VERSION=
COMPLIANCEHUB_PRIVACY_REVIEWED_AT=
COMPLIANCEHUB_PRIVACY_LOG_RETENTION_DAYS=14
COMPLIANCEHUB_PRIVACY_LEAD_RETENTION_DAYS=180
COMPLIANCEHUB_SECURITY_CONTACT=https://complywithai.de/kontakt
COMPLIANCEHUB_AUDIT_PSEUDONYMIZATION_KEY=

# Internal admin/GTM authentication. Production accepts mounted files only.
LEAD_ADMIN_SECRET=
LEAD_ADMIN_SECRET_FILE=
GTM_ALERT_SECRET=
GTM_ALERT_SECRET_FILE=

# Optional self-hosted webhook paths. Every production host must be explicitly allowlisted.
COMPLIANCEHUB_OUTBOUND_WEBHOOK_ALLOWED_HOSTS=
LEAD_SYNC_N8N_URL=
LEAD_SYNC_N8N_SECRET=
LEAD_SYNC_N8N_SECRET_FILE=
LEAD_INBOUND_WEBHOOK_URL=
LEAD_INBOUND_WEBHOOK_SECRET=
LEAD_INBOUND_WEBHOOK_SECRET_FILE=
GTM_ALERT_WEBHOOK_URL=
GTM_ALERT_WEBHOOK_SECRET=
GTM_ALERT_WEBHOOK_SECRET_FILE=
# HubSpot and Pipedrive connectors remain development-only and are rejected in production.
COMPLIANCEHUB_LEGAL_PUBLISH_READY=false

# Durable server-only state. Production uses private S3-compatible storage in DE/EU.
COMPLIANCEHUB_RUNTIME_STORAGE_BACKEND=local
COMPLIANCEHUB_RUNTIME_STORAGE_PREFIX=compliancehub/runtime/v1
COMPLIANCEHUB_S3_ENDPOINT=https://fsn1.your-objectstorage.com
COMPLIANCEHUB_S3_REGION=fsn1
COMPLIANCEHUB_S3_BUCKET=
COMPLIANCEHUB_S3_ALLOWED_HOSTS=
COMPLIANCEHUB_S3_FORCE_PATH_STYLE=false
# Mount rotating OpenBao-managed files with mode 0400/0600; never put values here.
COMPLIANCEHUB_S3_ACCESS_KEY_FILE=/run/secrets/s3-access-key
COMPLIANCEHUB_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3-secret-access-key
# Production release attestations; never set true without the runbook evidence.
COMPLIANCEHUB_RUNTIME_STORAGE_READY=false
COMPLIANCEHUB_CSP_REPORTING_READY=false

# Normalized tenant runtime state. Production PostgreSQL remains on the private Hetzner network.
COMPLIANCEHUB_RELATIONAL_RUNTIME_BACKEND=local
COMPLIANCEHUB_POSTGRES_ALLOWED_HOSTS=postgres.internal
POSTGRES_HOST=postgres.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=compliancehub
POSTGRES_USER=compliancehub_runtime
POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
COMPLIANCEHUB_ADVISOR_RUNTIME_RETENTION_DAYS=1095
# Optional private CA bundle; TLS certificate verification is never disabled.
POSTGRES_SSL_CA_PEM=
COMPLIANCEHUB_RELATIONAL_RUNTIME_READY=false
COMPLIANCEHUB_POSTGRES_RLS_READY=false
COMPLIANCEHUB_POSTGRES_NETWORK_READY=false
COMPLIANCEHUB_POSTGRES_BACKUP_RESTORE_READY=false
COMPLIANCEHUB_POSTGRES_RETENTION_READY=false
COMPLIANCEHUB_POSTGRES_DATA_MIGRATION_READY=false
COMPLIANCEHUB_POSTGRES_SUPPLY_CHAIN_READY=false
