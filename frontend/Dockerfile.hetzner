ARG NODE_BASE_IMAGE=node:22-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6
ARG NPM_REGISTRY_URL=https://registry.npmjs.org/
FROM ${NODE_BASE_IMAGE} AS dependencies
ARG NPM_REGISTRY_URL
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --registry="${NPM_REGISTRY_URL}" --replace-registry-host=always \
    --audit=false --fund=false --update-notifier=false

FROM ${NODE_BASE_IMAGE} AS builder
WORKDIR /workspace/frontend
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /workspace/frontend/node_modules ./node_modules
COPY frontend/ ./
# These reviewed contracts are inputs to the frontend prebuild gates. Keeping them in
# the image build prevents a narrower Docker context from silently skipping verification.
COPY db/postgres/migrations/20260715_advisor_runtime_state_rls.sql /workspace/db/postgres/migrations/20260715_advisor_runtime_state_rls.sql
COPY tests/postgres/advisor_runtime_state_rls_test.sql /workspace/tests/postgres/advisor_runtime_state_rls_test.sql
RUN npm run build

FROM ${NODE_BASE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    COMPLIANCEHUB_RUNTIME_PREFLIGHT=true \
    HOSTNAME=0.0.0.0 \
    PORT=3000
RUN addgroup --system --gid 10001 compliancehub \
    && adduser --system --disabled-password --no-create-home --uid 10001 --ingroup compliancehub compliancehub \
    && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
COPY --from=builder --chown=compliancehub:compliancehub /workspace/frontend/.next/standalone ./
COPY --from=builder --chown=compliancehub:compliancehub /workspace/frontend/.next/static ./.next/static
COPY --from=builder --chown=compliancehub:compliancehub /workspace/frontend/public ./public
COPY --from=builder --chown=compliancehub:compliancehub /workspace/frontend/scripts/verify-enterprise-readiness.mjs ./scripts/verify-enterprise-readiness.mjs
USER 10001:10001
EXPOSE 3000
CMD ["sh", "-c", "node scripts/verify-enterprise-readiness.mjs && exec node server.js"]
