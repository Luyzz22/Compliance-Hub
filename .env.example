# Runtime
COMPLIANCEHUB_ENV=dev
# Dependency telemetry is disabled by default and mandatory-off in production.
HAYSTACK_TELEMETRY_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Datenresidenz-Betriebsmodus des Deployments. Bestimmt die erlaubten Vendoren, die
# LLM-Provider-Kette und die Aussagen, die im Trust Center geführt werden dürfen.
# Werte: unrestricted | standard_dach | eu_sovereign | strict_sovereign
# Ohne Setzung gilt `unrestricted`: keine Vendor-Beschränkung und ausdrücklich keine
# zulässige Residenz- oder Souveränitätsaussage. Ein Modus, der Aussagen erlaubt, muss
# bewusst gewählt werden. Siehe docs/market-readiness/06-target-architecture-modes.md
COMPLIANCEHUB_SOVEREIGNTY_MODE=standard_dach
# Domain-basierte Admin-Vergabe ist in Produktion aus; nur mit dokumentierter Freigabe an.
COMPLIANCEHUB_ALLOW_DOMAIN_AUTO_ADMIN=false
# In Produktion Pflicht: absolute OpenBao-Secret-Datei (0400/0600) mit PostgreSQL-URL.
# COMPLIANCEHUB_DB_URL ist nur für lokale Entwicklung; in Produktion wird es abgelehnt.
COMPLIANCEHUB_DB_URL=
COMPLIANCEHUB_DB_URL_FILE=/run/secrets/backend-database-url
# In Produktion Pflicht für Advisor-Endpunkte (Komma-getrennte Allowlist).
COMPLIANCEHUB_ADVISOR_IDS=
COMPLIANCEHUB_VERSION=0.2.0
COMPLIANCEHUB_TRUSTED_HOSTS=localhost,127.0.0.1
COMPLIANCEHUB_CORS_ALLOWED_ORIGINS=http://localhost:3000
COMPLIANCEHUB_API_KEYS=
COMPLIANCEHUB_ALLOW_GLOBAL_API_KEYS=false
COMPLIANCEHUB_AUDIT_PSEUDONYMIZATION_KEY=
# Production: /run/secrets/audit-pseudonymization-key (set by deployment config).
COMPLIANCEHUB_AUDIT_PSEUDONYMIZATION_KEY_FILE=
COMPLIANCEHUB_MFA_ENCRYPTION_KEY=
# Production: eigener OpenBao-Key; nicht mit Credential-Pepper/Audit-Key teilen.
COMPLIANCEHUB_MFA_ENCRYPTION_KEY_FILE=
COMPLIANCEHUB_OPA_TRUST_CLIENT_ROLE_HEADER=false
# Production requires the internally hosted OPA service and an exact host allowlist.
COMPLIANCEHUB_OPA_STRICT_MISSING=false
COMPLIANCEHUB_OPA_ALLOWED_HOSTS=
OPA_URL=
OPA_POLICY_PATH=/v1/data/compliancehub/allow_action
# Monitoring readiness credential. Production accepts only the mounted file variant.
INTERNAL_HEALTH_API_KEY=
INTERNAL_HEALTH_API_KEY_FILE=
INTERNAL_HEALTH_ALLOWED_IPS=

# Optional self-hosted workflow plane. Keep disabled unless a private Temporal cluster
# and its exact hostname allowlist have been approved. Temporal Cloud API keys are
# forbidden in restrictive sovereignty modes.
COMPLIANCEHUB_TEMPORAL_ENABLED=false
COMPLIANCEHUB_TEMPORAL_ALLOWED_HOSTS=
TEMPORAL_ADDRESS=localhost:7233
COMPLIANCEHUB_SESSION_TTL_MINUTES=480
COMPLIANCEHUB_APP_ORIGIN=http://localhost:3000
COMPLIANCEHUB_PUBLIC_DEMO_ENABLED=false
COMPLIANCEHUB_BFF_SHARED_SECRET=
# Production: /run/secrets/bff-shared-secret (set by deployment config).
COMPLIANCEHUB_BFF_SHARED_SECRET_FILE=
COMPLIANCEHUB_CREDENTIAL_PEPPER=
# Production: separate OpenBao secret used for deterministic API-key/session lookup HMACs.
COMPLIANCEHUB_CREDENTIAL_PEPPER_FILE=

# Self-hosted automation/export webhooks. Production requires absolute mounted secret
# files plus exact host allowlists; embedded query credentials are rejected.
COMPLIANCEHUB_N8N_ALLOWED_HOSTS=
COMPLIANCEHUB_N8N_WEBHOOK_URL=
COMPLIANCEHUB_N8N_WEBHOOK_SECRET=
COMPLIANCEHUB_N8N_WEBHOOK_SECRET_FILE=
COMPLIANCEHUB_EXPORT_WEBHOOK_ALLOWED_HOSTS=
COMPLIANCEHUB_EXPORT_GENERIC_WEBHOOK_URL=
COMPLIANCEHUB_EXPORT_SAP_BTP_URL=
COMPLIANCEHUB_EXPORT_DATEV_DMS_URL=
COMPLIANCEHUB_EXPORT_WEBHOOK_SECRET=
COMPLIANCEHUB_EXPORT_WEBHOOK_SECRET_FILE=

# Microsoft Entra ID — confidential web application, tenant-specific OIDC.
COMPLIANCEHUB_ENTRA_ENABLED=false
COMPLIANCEHUB_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
COMPLIANCEHUB_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
COMPLIANCEHUB_ENTRA_CLIENT_SECRET=
COMPLIANCEHUB_ENTRA_CLIENT_SECRET_FILE=
COMPLIANCEHUB_ENTRA_PROVIDER_ID=00000000-0000-0000-0000-000000000000
COMPLIANCEHUB_AUTH_TRANSACTION_SECRET=
COMPLIANCEHUB_AUTH_TRANSACTION_SECRET_FILE=
COMPLIANCEHUB_ENTRA_CONDITIONAL_ACCESS_READY=false
COMPLIANCEHUB_ENTRA_PROVISIONING_READY=false
COMPLIANCEHUB_ALLOW_LEGACY_SSO_CALLBACK=false

# Azure OpenAI — Hetzner uses a certificate-backed Entra workload identity.
# `managed_identity` remains valid only when the backend itself runs in Azure.
COMPLIANCEHUB_FEATURE_LLM_ENABLED=false
COMPLIANCEHUB_FEATURE_LLM_CHAT_ASSISTANT=false
COMPLIANCEHUB_LLM_PREFER_AZURE=true
COMPLIANCEHUB_LLM_ASSUME_AZURE_EU=false
COMPLIANCEHUB_LLM_PII_MODE=block
# Provider-unabhängige Egress-/Kostenlimits. Null deaktiviert nur den jeweiligen
# Tageszähler; der Prompt- und Outputdeckel bleibt aktiv.
COMPLIANCEHUB_LLM_MAX_PROMPT_CHARACTERS=48000
COMPLIANCEHUB_LLM_MAX_OUTPUT_TOKENS=1024
COMPLIANCEHUB_LLM_DAILY_CALL_LIMIT=0
COMPLIANCEHUB_LLM_DAILY_TOKEN_LIMIT=0
# Ausschließlich für den freigegebenen, unveränderlichen Demomandanten aktivieren.
# Startup bricht bei fehlender Azure-/Sovereignty-/Budget-Konfiguration ab.
COMPLIANCEHUB_FEATURE_DEMO_MODE=false
COMPLIANCEHUB_DEMO_BLOCK_ALL_MUTATIONS=true
COMPLIANCEHUB_DEMO_AZURE_INFERENCE_ENABLED=false
COMPLIANCEHUB_DEMO_SYNTHETIC_ONLY_ATTESTED=false
# Externe APIs erhalten standardmäßig höchstens public/internal. Eine Freigabe von
# confidential erfolgt ausschließlich mandantenspezifisch über
# COMPLIANCEHUB_LLM_TENANT_POLICIES_JSON oder einen DB-Override. Restricted bleibt lokal.
COMPLIANCEHUB_LLM_TENANT_POLICIES_JSON=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-GPT-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
AZURE_OPENAI_AUTH=client_certificate
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_CERTIFICATE_PATH=/run/secrets/azure-openai-client-certificate.pem
# Local break-glass only; production uses managed identity/Key Vault.
AZURE_OPENAI_API_KEY=
# Optionaler privater vLLM/Ollama-Endpunkt. Interne DNS-Namen müssen zusätzlich in
# COMPLIANCEHUB_LLAMA_PRIVATE_HOSTS stehen; öffentliche Hosts werden nicht als lokal akzeptiert.
LLAMA_BASE_URL=
COMPLIANCEHUB_LLAMA_PRIVATE_HOSTS=

# Production release attestations (set only after evidence-backed review).
COMPLIANCEHUB_RELEASE_CHANNEL=development
COMPLIANCEHUB_ENTERPRISE_AUTH_READY=false
COMPLIANCEHUB_LEGAL_PUBLISH_READY=false
