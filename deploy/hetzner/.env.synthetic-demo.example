# Non-secret configuration for the private, synthetic-only customer demonstration.
# This profile is deliberately not a production release and must remain IP restricted.
COMPLIANCEHUB_PUBLIC_HOST=demo.complywithai.de
COMPLIANCEHUB_DEMO_ALLOWED_CIDR=203.0.113.10/32
COMPLIANCEHUB_APP_ORIGIN=https://demo.complywithai.de
COMPLIANCEHUB_TRUSTED_HOSTS=demo.complywithai.de
COMPLIANCEHUB_CORS_ALLOWED_ORIGINS=https://demo.complywithai.de
COMPLIANCEHUB_API_ALLOWED_HOSTS=backend

COMPLIANCEHUB_FRONTEND_IMAGE=compliancehub-frontend:synthetic-demo
COMPLIANCEHUB_BACKEND_IMAGE=compliancehub-backend:synthetic-demo
COMPLIANCEHUB_RELEASE_ID=synthetic-demo-YYYYMMDDTHHMMSSZ
COMPLIANCEHUB_RELEASE_COMMIT=0000000000000000000000000000000000000000
COMPLIANCEHUB_RELEASE_CHANNEL=pilot
COMPLIANCEHUB_RELEASE_PROFILE=synthetic_demo

COMPLIANCEHUB_SOVEREIGNTY_MODE=standard_dach
HAYSTACK_TELEMETRY_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
COMPLIANCEHUB_TEMPORAL_ENABLED=false
COMPLIANCEHUB_SESSION_TTL_MINUTES=120

# Authentication is a bounded exception for the IP-restricted synthetic preview.
# Self-registration and anonymous demo access remain disabled.
COMPLIANCEHUB_ENTRA_ENABLED=false
COMPLIANCEHUB_PASSWORD_LOGIN_ENABLED=true
COMPLIANCEHUB_SELF_REGISTRATION_ENABLED=false
COMPLIANCEHUB_PUBLIC_DEMO_ENABLED=false
COMPLIANCEHUB_DEMO_OPERATOR_EMAIL=demo-operator@complywithai.de

# Fixed synthetic Azure path: no free text, no upload, read-only demo tenant.
COMPLIANCEHUB_FEATURE_DEMO_MODE=true
COMPLIANCEHUB_DEMO_BLOCK_ALL_MUTATIONS=true
COMPLIANCEHUB_DEMO_AZURE_INFERENCE_ENABLED=true
COMPLIANCEHUB_DEMO_SYNTHETIC_ONLY_ATTESTED=true
COMPLIANCEHUB_FEATURE_LLM_ENABLED=true
COMPLIANCEHUB_FEATURE_LLM_CHAT_ASSISTANT=true
COMPLIANCEHUB_LLM_PREFER_AZURE=true
COMPLIANCEHUB_LLM_ASSUME_AZURE_EU=true
COMPLIANCEHUB_LLM_PII_MODE=block
COMPLIANCEHUB_LLM_MAX_PROMPT_CHARACTERS=12000
COMPLIANCEHUB_LLM_MAX_OUTPUT_TOKENS=800
COMPLIANCEHUB_LLM_DAILY_CALL_LIMIT=20
COMPLIANCEHUB_LLM_DAILY_TOKEN_LIMIT=50000
AZURE_OPENAI_ENDPOINT=https://complywithai-demo-openai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-6-terra-eu-demo
AZURE_OPENAI_AUTH=client_certificate
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Private Hetzner Object Storage in the same NBG1 region.
COMPLIANCEHUB_RUNTIME_STORAGE_BACKEND=s3
COMPLIANCEHUB_RUNTIME_STORAGE_PREFIX=compliancehub/synthetic-demo/v1
COMPLIANCEHUB_S3_ENDPOINT=https://nbg1.your-objectstorage.com
COMPLIANCEHUB_S3_REGION=nbg1
COMPLIANCEHUB_S3_BUCKET=replace-with-private-synthetic-demo-bucket
COMPLIANCEHUB_S3_ALLOWED_HOSTS=nbg1.your-objectstorage.com
COMPLIANCEHUB_S3_FORCE_PATH_STYLE=false

# Container-private PostgreSQL. This is acceptable only for synthetic preview data;
# production requires an independently operated database and evidenced restore process.
COMPLIANCEHUB_RELATIONAL_RUNTIME_BACKEND=postgres
COMPLIANCEHUB_POSTGRES_ALLOWED_HOSTS=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=compliancehub
POSTGRES_USER=compliancehub_frontend
COMPLIANCEHUB_ADVISOR_RUNTIME_RETENTION_DAYS=30

# Legal publication remains closed. Do not remove the IP allowlist or switch public DNS
# until the real values and privacy notice have completed legal review.
COMPLIANCEHUB_LEGAL_PUBLISH_READY=false
COMPLIANCEHUB_LEGAL_ENTITY_NAME=Synthetische Demonstrationsumgebung
COMPLIANCEHUB_LEGAL_REPRESENTATIVE=Andreas Schenk
COMPLIANCEHUB_LEGAL_STREET=Nicht öffentlich freigegeben
COMPLIANCEHUB_LEGAL_POSTAL_CODE=00000
COMPLIANCEHUB_LEGAL_CITY=Nicht öffentlich freigegeben
COMPLIANCEHUB_LEGAL_COUNTRY=Deutschland
COMPLIANCEHUB_LEGAL_EMAIL=demo-operator@complywithai.de
COMPLIANCEHUB_LEGAL_REGISTER_COURT=Nicht öffentlich freigegeben
COMPLIANCEHUB_LEGAL_REGISTER_NUMBER=Nicht öffentlich freigegeben
COMPLIANCEHUB_LEGAL_VAT_ID=DE000000000
COMPLIANCEHUB_PRIVACY_EMAIL=demo-operator@complywithai.de
COMPLIANCEHUB_PRIVACY_NOTICE_VERSION=synthetic-preview-not-public
COMPLIANCEHUB_PRIVACY_REVIEWED_AT=2026-08-21
COMPLIANCEHUB_PRIVACY_LOG_RETENTION_DAYS=14
COMPLIANCEHUB_PRIVACY_LEAD_RETENTION_DAYS=30
COMPLIANCEHUB_SECURITY_CONTACT=mailto:security@complywithai.de

# Evidence-backed enterprise gates intentionally stay false in this preview.
COMPLIANCEHUB_RUNTIME_STORAGE_READY=false
COMPLIANCEHUB_RELATIONAL_RUNTIME_READY=false
COMPLIANCEHUB_POSTGRES_RLS_READY=false
COMPLIANCEHUB_POSTGRES_NETWORK_READY=false
COMPLIANCEHUB_POSTGRES_BACKUP_RESTORE_READY=false
COMPLIANCEHUB_POSTGRES_RETENTION_READY=false
COMPLIANCEHUB_POSTGRES_DATA_MIGRATION_READY=false
COMPLIANCEHUB_POSTGRES_SUPPLY_CHAIN_READY=false
COMPLIANCEHUB_ENTERPRISE_AUTH_READY=false
COMPLIANCEHUB_CSP_REPORTING_READY=false
